{
  "version": "contextkv-atomic-response-schemas-v1",
  "extract": {
    "type": "object",
    "properties": {
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "claim_id": {
              "type": "string",
              "minLength": 1
            },
            "unit_id": {
              "type": "string",
              "minLength": 1
            },
            "answer_quote": {
              "type": "string",
              "minLength": 1
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "assertion",
                "abstention",
                "recommendation",
                "hypothetical",
                "ambiguous"
              ]
            },
            "object": {
              "type": [
                "string",
                "null"
              ]
            },
            "relation": {
              "type": [
                "string",
                "null"
              ]
            },
            "value_raw": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "unit_raw": {
              "type": [
                "string",
                "null"
              ]
            },
            "comparator": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "negation": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "modality": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "asserted",
                "conditional",
                "recommended",
                "hypothetical",
                "uncertain",
                null
              ]
            },
            "citation_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "claim_id",
            "unit_id",
            "answer_quote",
            "statement",
            "kind",
            "object",
            "relation",
            "value_raw",
            "unit_raw",
            "comparator",
            "scope",
            "conditions",
            "negation",
            "modality",
            "citation_ids"
          ],
          "additionalProperties": false
        }
      },
      "uncovered_units": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unit_id": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "enum": [
                "code",
                "nonverifiable",
                "heading",
                "unresolved_ambiguity",
                "other"
              ]
            }
          },
          "required": [
            "unit_id",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "claims",
      "uncovered_units"
    ],
    "additionalProperties": false
  },
  "check": {
    "type": "object",
    "properties": {
      "claim_id": {
        "type": "string",
        "minLength": 1
      },
      "extraction_faithful": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "verdict": {
        "type": "string",
        "enum": [
          "entailed",
          "contradicted",
          "insufficient",
          "ambiguous",
          "not_verifiable"
        ]
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reference_id": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "relation": {
              "type": "string",
              "enum": [
                "supports",
                "opposes",
                "qualifies"
              ]
            }
          },
          "required": [
            "reference_id",
            "quote",
            "relation"
          ],
          "additionalProperties": false
        }
      },
      "failed_slots": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "source_answers_current_question": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "claim_id",
      "extraction_faithful",
      "verdict",
      "evidence",
      "failed_slots",
      "reason",
      "source_answers_current_question"
    ],
    "additionalProperties": false
  },
  "scope": "Fixed output structure and allowed slot types only; no sample labels, dynamic source IDs or semantic implications. Existing host quote/fidelity/support checks still apply.",
  "request_contract": "OpenAI-compatible response_format type=json_schema, json_schema name/schema/strict=true; explicit opt-in only",
  "verified_server_source": "https://github.com/sgl-project/sglang/tree/3f36fc08331f64cd63c4fbbdf39cc402f38bb38b",
  "grammar_backend": "xgrammar (server configuration must be recorded); pinned server dependency xgrammar==0.2.7",
  "authorship": "Original ContextKV schemas; no upstream implementation copied"
}
